          <mxGeometry x="876" y="630" width="388" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s3_nav" value="Home | スコア | 履歴 | プロフ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF6EC;strokeColor=#E0D5BC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="686" width="380" height="44" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3. データモデル + API" id="data">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="データモデル + API コントラクト" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>

        <!-- ============================ -->
        <!-- データモデル -->
        <!-- ============================ -->
        <mxCell id="dm_label" value="データモデル (Frontend / Backend 共通)" style="text;html=1;fontSize=14;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="dm_before" value="🔴 現状&#xa;&#xa;Selection = {&#xa;  persona_ids: string[]   // builtin/my DB id のみ&#xa;}&#xa;&#xa;PersonaSource = &quot;builtin&quot; | &quot;anonymous&quot;&#xa;// localStorage で別管理&#xa;// anonymous source の選択 ID は持たない (random)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#B83232;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="500" height="160" as="geometry" />
        </mxCell>

        <mxCell id="dm_after" value="🟢 新設計&#xa;&#xa;type SelectedPersona = {&#xa;  source: &quot;builtin&quot; | &quot;anonymous&quot; | &quot;my&quot;&#xa;  id: string   // それぞれの DB / pool 内 UUID&#xa;}&#xa;&#xa;type Selection = SelectedPersona[]   // max 3, source 混在可&#xa;&#xa;// persona_source 概念は廃止 (selection が source を内包)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EB;strokeColor=#21A48F;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="500" height="160" as="geometry" />
        </mxCell>

        <!-- ============================ -->
        <!-- API -->
        <!-- ============================ -->
        <mxCell id="api_label" value="API コントラクト変更" style="text;html=1;fontSize=14;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="400" height="24" as="geometry" />
        </mxCell>

        <!-- API 1: GET /persona-pool/list (new) -->
        <mxCell id="api_1" value="① GET /v1/persona-pool/list?limit=20  [新規]&#xa;&#xa;Response:&#xa;{&#xa;  personas: [&#xa;    { persona_id, value_tags, primary_language, formality }&#xa;  ]&#xa;}&#xa;&#xa;Note: caller の persona は exclude (NFR-6 + 「自分を除外」)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EB;strokeColor=#21A48F;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="500" height="140" as="geometry" />
        </mxCell>

        <!-- API 2: POST /decisions/request/stream -->
        <mxCell id="api_2" value="② POST /v1/decisions/request/stream  [拡張]&#xa;&#xa;Request:&#xa;{&#xa;  user_input: &quot;...&quot;,&#xa;  selected_personas: [&#xa;    { source: &quot;builtin&quot;, id: &quot;uuid&quot; },&#xa;    { source: &quot;anonymous&quot;, id: &quot;uuid&quot; },&#xa;    { source: &quot;my&quot;, id: &quot;uuid&quot; }&#xa;  ]&#xa;}&#xa;&#xa;backward compat: 旧 persona_source + selected_persona_ids も受け付け" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EB;strokeColor=#21A48F;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="560" y="340" width="540" height="200" as="geometry" />
        </mxCell>

        <!-- API 3: PUT /personas/me/selection -->
        <mxCell id="api_3" value="③ PUT /v1/personas/me/selection  [拡張]&#xa;&#xa;Request:&#xa;{&#xa;  personas: [&#xa;    { source: &quot;builtin&quot;, id },&#xa;    { source: &quot;anonymous&quot;, id }&#xa;  ]&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EB;strokeColor=#21A48F;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="500" height="160" as="geometry" />
        </mxCell>

        <!-- Backend resolver flow -->
        <mxCell id="resolver_label" value="Backend persona resolver flow (decision engine)" style="text;html=1;fontSize=14;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="resolver" value="for entry in request.selected_personas:&#xa;    if entry.source == &quot;anonymous&quot;:&#xa;        spec = pool_repo.get_by_id(entry.id, excluding_sub=caller)  # 自分は拒否&#xa;        prompt = build_anonymous_prompt(spec)&#xa;    elif entry.source in (&quot;builtin&quot;, &quot;my&quot;):&#xa;        persona = persona_repo.get(entry.id)&#xa;        prompt = build_builtin_prompt(persona)&#xa;    yield utterance_event(spec/persona, prompt)&#xa;# NO self_spec injection&#xa;# total = len(selected_personas) (典型 3、最少 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#21A48F;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="1060" height="140" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
