        <mxCell id="p1_psum_tanaka" value="&lt;b style=&quot;font-size:14px&quot;&gt;田中 涼介&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;32 歳・中堅 IT 企業 PdM&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;メインターゲット&lt;br&gt;「判断疲労を抱える現代人」&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;判断疲労から解放され、Yes で承認するだけで一日が回る感覚を得たい&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=8;arcSize=8" vertex="1" parent="1">
