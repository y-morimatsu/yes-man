        <mxCell id="p1_psum_yamada" value="&lt;b style=&quot;font-size:14px&quot;&gt;山田 啓介&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;41 歳・スタートアップ CEO&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;対比ペルソナ (ターゲット外)&lt;br&gt;「自分の意志を強く持っている人」&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;AI に意思決定を委ねることへの違和感、自律性 (autonomy) への強い志向&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9C27B0;strokeColor=#4A148C;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=8;arcSize=8" vertex="1" parent="1">
