        <mxCell id="p6_r_cv1" value="R10: SSE 切断・プロキシ非対応&#10;モバイル網不安定 (FR-CV)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;fontColor=#212121;fontSize=10;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=10;arcSize=4;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="550" y="555" width="300" height="44" as="geometry"/>
