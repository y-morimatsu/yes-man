        <mxCell id="p8_dep_2" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F;strokeWidth=2;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;curved=0" source="p8_st_2" target="p8_st_3" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p8_dep_3" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F;strokeWidth=2;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;curved=0" source="p8_st_3" target="p8_st_4" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p8_dep_4" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F;strokeWidth=2;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;curved=0" source="p8_st_4" target="p8_st_5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p8_dep_5" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F;strokeWidth=2;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;curved=0" source="p8_st_5" target="p8_st_6" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p8_dep_6" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#37474F;strokeWidth=2;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;curved=0" source="p8_st_6" target="p8_st_7" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p8_note_t" value="依存解決のポイント" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1000" y="130" width="460" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p8_note1" value="• NetworkStack はすべての前提
• AuthStack / DataStack / ObservabilityStack は並列構築可
• ComputeStack は DataStack の Secrets Manager 認証情報を参照
• AsyncStack は ComputeStack の ALB エンドポイントを必要とする
• AIStack は IAM 設定中心 (リソース依存少)
• FrontendStack は完全独立、並列実行可 (任意のタイミング)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF59D;strokeColor=#F57F17;fontSize=10;align=left;verticalAlign=top;spacing=6" vertex="1" parent="1">
          <mxGeometry x="1000" y="170" width="460" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="p8_note2" value="【Init Container】

ECS Task 起動時に Alembic マイグレーション実行:
  1. Init Container が Aurora に接続
  2. alembic upgrade head
  3. Init 終了 → メインコンテナ起動 (FastAPI)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF59D;strokeColor=#F57F17;fontSize=10;align=left;verticalAlign=top;spacing=6" vertex="1" parent="1">
          <mxGeometry x="1000" y="400" width="460" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="p8_note3" value="【ローカル開発時】

• docker-compose.yml で PostgreSQL + cognito-local 起動
• AUTH_BACKEND=mock / STORAGE_BACKEND=docker-postgres
• LLM_PROVIDER=local-llm (Ollama 等)
• AWS リソースに依存せず開発・テスト可能" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF59D;strokeColor=#F57F17;fontSize=10;align=left;verticalAlign=top;spacing=6" vertex="1" parent="1">
          <mxGeometry x="1000" y="580" width="460" height="160" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
