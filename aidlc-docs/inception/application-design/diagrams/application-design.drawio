        <mxCell id="p9_idx" value="• decisions(user_id, created_at DESC)  — 履歴取得・タイムライン
• decisions(user_id, user_choice)        — Yes/No 集計、スコア計算
• decisions(domain_classification)       — ドメイン別集計
• preference_profiles(user_id)           — PK のみで十分
• silence_logs(user_id, created_at DESC) — 沈黙履歴
• silence_logs(detected_domain)          — ドメイン別集計" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF59D;strokeColor=#F57F17;fontSize=10;align=left;verticalAlign=top;spacing=6" vertex="1" parent="1">
