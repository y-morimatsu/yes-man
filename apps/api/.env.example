# YesMan API — environment variable template (U3 完了時点)
# Copy to .env and adjust for your local setup.

# === App ===
APP_ENV=dev
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# === Backend swap (FR-AUTH-05 / FR-HIST-04 / FR-VOICE-01 / FR-AI-01..03) ===
STORAGE_BACKEND=mock              # aurora | docker-postgres | mock
AUTH_BACKEND=mock                 # cognito | cognito-local | mock
LLM_PROVIDER=mock
VOICE_BACKEND=mock
EVENT_BACKEND=sync

# === Database (storage_backend=aurora の場合は parts、docker-postgres は DATABASE_URL) ===
DATABASE_URL=sqlite+aiosqlite:///:memory:
# AURORA_HOST=
# AURORA_PORT=5432
# AURORA_DBNAME=yesman
# DATABASE_USERNAME=yesman
# DATABASE_PASSWORD=

# === Origin verify (U1) ===
ORIGIN_VERIFY_SECRET=

# === Cognito (auth_backend=cognito 必須) ===
# COGNITO_REGION=ap-northeast-1
# COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
# COGNITO_APP_CLIENT_ID=
# COGNITO_HOSTED_UI_URL=https://yesman-prod.auth.ap-northeast-1.amazoncognito.com

# === cognito-local (auth_backend=cognito-local 必須) ===
# COGNITO_LOCAL_ISSUER_URL=http://localhost:9229/local_xxx
# COGNITO_LOCAL_USERINFO_URL=                  # 任意、未設定で ID Token only mode

# === Mock (auth_backend=mock、dev/ci 限定) ===
MOCK_USER_SUB=11111111-1111-1111-1111-111111111111
MOCK_USER_EMAIL=test@yesman.local
MOCK_AUTO_USER=false              # true で Authorization header 省略時も mock user で通過

# === CORS / Bypass ===
CORS_ALLOWED_ORIGINS=             # 本番必須、カンマ区切り (例: https://yesman-prod.cloudfront.net)
AUTH_BYPASS_PATHS_EXTRA=          # 任意、カンマ区切り

# === JWKS / userInfo cache ===
JWKS_CACHE_TTL_SECONDS=3600
JWKS_STALE_WHILE_ERROR_SECONDS=300
USERINFO_CACHE_TTL_SECONDS=300

# === U4 / decision (12 個、Infrastructure Design §7) ===
# 認証は U3 既存設定 (AUTH_BACKEND=mock など) に従う

# Backend swap (U4 で意味を持つ)
# LLM_PROVIDER は U2 既存 (mock / bedrock)、EVENT_BACKEND も U2 既存 (sync / inline-async / eventbridge)

# Bedrock (LLM_PROVIDER=bedrock 時)
# BEDROCK_REGION=ap-northeast-1
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT

# LLM Timeout / Retry
DECISION_LLM_TIMEOUT_SECONDS=30.0
DECISION_LLM_STREAM_INITIAL_TIMEOUT_SECONDS=5.0
DECISION_LLM_STREAM_TOTAL_TIMEOUT_SECONDS=120.0
DECISION_LLM_RETRY_COUNT=1

# Nudge
NUDGE_GENERATION_ENABLED=true
NUDGE_CACHE_TTL_SECONDS=600.0

# EventBridge (EVENT_BACKEND=eventbridge 時必須)
# EVENT_BUS_NAME=

# SilenceLog hash salt
# prod は Secrets Manager 経由で ECS Task に注入 (環境変数直書き禁止、SEC-U4-03)
# dev/ci は .env 直書き OK
# SILENCE_HASH_SALT=

# === U5 / learning (5 個、Infrastructure Design §4) ===
# Consumer 起動条件 (AND 論理): LEARNING_CONSUMER_ENABLED=true AND EVENT_BACKEND=eventbridge
LEARNING_CONSUMER_ENABLED=true
LEARNING_LONG_POLL_SECONDS=5
LEARNING_RETRY_SLEEP_SECONDS=30
LEARNING_SUPERVISOR_BACKOFF_MAX_SECONDS=300

# DECISION_EVENTS_QUEUE_URL (EVENT_BACKEND=eventbridge + LEARNING_CONSUMER_ENABLED=true で必須、U1 ApiStack 由来)
# DECISION_EVENTS_QUEUE_URL=

# === U-Persona (3 個、Infrastructure Design §1) ===
# PersonaSummary 匿名化 salt (NFR Req SEC-UP-04)
# prod は Secrets Manager 経由で ECS Task に注入 (環境変数直書き禁止)
# dev/ci は .env 直書き OK
# PERSONA_ANONYMIZER_SALT=test-persona-salt
PERSONA_REPORT_AUTO_BLOCK_THRESHOLD=5
PERSONA_MODERATOR_LLM_TIMEOUT_SECONDS=5.0

# === U6 / voice (6 個、Infrastructure Design §1) ===
# VOICE_BACKEND は上部 Backend swap で既に定義 (aws | web-speech-api | mock)
POLLY_VOICE_ID=Takumi           # Polly Neural × ja-JP (NFR Design §4.1.1)
POLLY_ENGINE=neural             # neural | standard (MVP: neural 固定)
POLLY_REGION=ap-northeast-1
TRANSCRIBE_REGION=ap-northeast-1
# VOICE_BACKEND=aws 時必須、prod は CDK 経由で自動注入
# VOICE_S3_BUCKET=yesman-dev-voice
VOICE_TTS_PRESIGNED_TTL_SECONDS=3600
