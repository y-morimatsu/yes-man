{
  "name": "@yesman/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "YesMan PWA - Web Shell (U7a) + Features (U7d)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src tests",
    "size": "size-limit",
    "version:inject": "echo \"VITE_APP_VERSION=$(git rev-parse --short HEAD)\" > .env.local"
  },
  "size-limit": [
    {
      "name": "main bundle",
      "path": "dist/assets/index-*.js",
      "limit": "250 KB"
    },
    {
      "name": "tanstack-query shared chunk",
      "path": "dist/assets/tanstack-query-*.js",
      "limit": "20 KB"
    },
    {
      "name": "react-vendor shared chunk",
      "path": "dist/assets/react-vendor-*.js",
      "limit": "60 KB"
    }
  ],
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@yesman/api-client": "workspace:*",
    "@yesman/ui": "workspace:*",
    "aws-amplify": "^6.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@size-limit/preset-app": "^11.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fast-check": "^4.8.0",
    "jsdom": "^25.0.0",
    "msw": "^2.0.0",
    "rollup-plugin-visualizer": "^5.0.0",
    "size-limit": "^11.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.0.0"
  }
}
