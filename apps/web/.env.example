# YesMan Web (U7a) — environment variables.
# Copy to .env.local for local dev.

# === API ===
VITE_API_BASE_URL=http://localhost:8000

# === Cognito (U3) ===
VITE_COGNITO_REGION=ap-northeast-1
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_HOSTED_UI_URL=https://yesman-dev.auth.ap-northeast-1.amazoncognito.com

# === Release identifier (CI で git rev-parse --short HEAD で注入推奨) ===
# VITE_APP_VERSION=dev
