    <diagram name="04_State_Machine" id="page4">
        <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p4_title" value="認証状態遷移 (Mock mode)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p4_sub" value="AuthProvider.status と localStorage flag の連動、関数呼び出しの責務分担" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#616161" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="1220" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="p4_unauth" value="🔓 unauthenticated&#10;&#10;current-email = null&#10;Header: Sign out 非表示&#10;RequireAuth → /auth/signin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#FB8C00;fontColor=#E65100;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;strokeWidth=3" parent="1" vertex="1">
                    <mxGeometry x="100" y="320" width="280" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p4_auth" value="🔐 authenticated&#10;&#10;current-email = X&#10;Header: Sign out 表示&#10;RequireAuth → 通過" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontColor=#1B5E20;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;strokeWidth=3" parent="1" vertex="1">
                    <mxGeometry x="900" y="320" width="280" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e1" style="endArrow=classic;html=1;rounded=1;edgeStyle=none;strokeColor=#388E3C;strokeWidth=3;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;curved=1" parent="1" source="p4_unauth" target="p4_auth" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="640" y="280"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p4_e1_lbl" value="signIn(email)&#10;1. registerUser(email)&#10;2. setCurrentEmail(email)&#10;3. AuthProvider.refresh()" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#1B5E20;whiteSpace=wrap" parent="1" vertex="1">
                    <mxGeometry x="510" y="220" width="260" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="p4_e2" style="endArrow=classic;html=1;rounded=1;edgeStyle=none;strokeColor=#FB8C00;strokeWidth=3;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;curved=1" parent="1" source="p4_auth" target="p4_unauth" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="640" y="520"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p4_e2_lbl" value="signOutUser()&#10;1. clearCurrent()&#10;2. AuthProvider.refresh()&#10;→ RequireAuth が detect&#10;→ /auth/signin redirect" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#E65100;whiteSpace=wrap" parent="1" vertex="1">
                    <mxGeometry x="510" y="540" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p4_ls_title" value="localStorage scheme" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0A0A0A" parent="1" vertex="1">
                    <mxGeometry x="100" y="700" width="280" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p4_ls_box" value="yesman:mock-auth:users&#10;  → MockUser[] (JSON)&#10;&#10;yesman:mock-auth:current-email&#10;  → string | null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontColor=#880E4F;fontSize=11;align=left;verticalAlign=top;arcSize=8;spacingLeft=12;spacingTop=8;fontFamily=Courier New" parent="1" vertex="1">
                    <mxGeometry x="100" y="730" width="380" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p4_resp_title" value="責務分担" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#0A0A0A" parent="1" vertex="1">
                    <mxGeometry x="540" y="700" width="280" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="p4_resp_box" value="mockAuthStorage  : localStorage CRUD (pure)&#10;auth.ts          : signIn() / signOutUser() — bypass 分岐&#10;AuthProvider     : status state + refresh()&#10;SignInPage       : form + サインインボタン + ユーザ list&#10;Layout           : Sign out button + refresh trigger&#10;RequireAuth      : status 監視 + redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontColor=#01579B;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=12;spacingTop=8;fontFamily=Courier New" parent="1" vertex="1">
                    <mxGeometry x="540" y="730" width="660" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p4_note" value="※ env.authBypass=false (real Cognito) では signIn()/signOutUser() は aws-amplify の path に分岐。本 spec はその path を touch しない。" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#616161;whiteSpace=wrap" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="1220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p4_constraint" value="⚠ 制約: API 側 MockAuthAdapter は env 固定 sub を返すため、frontend で email を切り替えても Profile/履歴データは同一行を参照する (cosmetic only)" style="text;html=1;strokeColor=#FB8C00;fillColor=#FFF3E0;fontColor=#E65100;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;whiteSpace=wrap" parent="1" vertex="1">
                    <mxGeometry x="40" y="160" width="1220" height="36" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
