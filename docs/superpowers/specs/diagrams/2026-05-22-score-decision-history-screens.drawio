                </mxCell>
                <mxCell id="p1_anno_item" value="DecisionHistoryItem (Card primitive)&#xa;rounded-xl border border-neutral-200, p-3 mb-2&#xa;✓ 緑チェック (success-700 #43A047) を左端に subtle 表示&#xa;質問 (font-serif italic, max 60 chars + …)&#xa;提案 (text-sm, max 60 chars + …)&#xa;相対時刻 (text-xs text-neutral-500)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontColor=#01579B;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=8;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="40" y="540" width="240" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p1_anno_time" value="時刻 ・ 採用回数 (1 行)&#xa;&#xa;◆ 相対時刻 (formatRelativeTime)&#xa;  &lt; 1h:  「N 分前」/ &lt; 24h: 「N 時間前」&#xa;  &lt; 2d:  「昨日」/ &lt; 7d:  「N 日前」&#xa;  ≥ 7d:  「YYYY-MM-DD」&#xa;&#xa;◆ 採用回数 (no_attempt_count + 1)&#xa;  = 1: 🌟 1 回目で採用 (一発採用)&#xa;  ≥ 2: 🔄 N 回目で採用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#E65100;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=8;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="720" y="470" width="240" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p1_anno_api" value="Data source&#xa;GET /v1/decisions?limit=20&amp;choice=yes&#xa;Filter: user_choice = &apos;yes&apos; のみ&#xa;        (no / pending は除外)&#xa;Order: created_at DESC&#xa;Fields: id, user_input, proposal_text,&#xa;        created_at, no_attempt_count&#xa;React Query: useDecisionHistory()&#xa;staleTime: 30s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontColor=#880E4F;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=8;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="720" y="640" width="240" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="p1_anno_no" value="No (棄却) は履歴に残さない&#xa;ユーザーが No した提案は「無かったこと」に。&#xa;= デモ的にも YesMan の世界観 (Yes を称える) に合致&#xa;※ ただし DB には保存される (Score 計算用)。&#xa;  あくまで履歴 UI からのみ非表示。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#B71C1C;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=8;spacingTop=6;fontStyle=1" parent="1" vertex="1">
