                </mxCell>
                <mxCell id="anno_arrow3" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#FB8C00;strokeWidth=2;endFill=1" parent="1" source="anno_main_pad" target="iphone_main" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="anno_bottom_safe" value="↓ Home indicator 領域&#xa;safe-area-inset-bottom&#xa;で BottomNav padding 確保" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontColor=#01579B;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=8;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="380" y="610" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="anno_arrow4" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#0288D1;strokeWidth=2;endFill=1" parent="1" source="anno_bottom_safe" target="iphone_safe_bottom_area" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="micro_title" value="Microinteractions (Package B)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#262626;spacingLeft=12" parent="1" vertex="1">
                    <mxGeometry x="640" y="100" width="320" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="b1_box" value="B-1 ✓ Active States 全 button/link&#xa;&#xa;Tap 時に active:scale-[0.98] active:opacity-80&#xa;hover: は維持 (デスクトップ互換)&#xa;@yesman/ui Button + Card primitive で一括適用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontColor=#880E4F;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=8;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="640" y="130" width="320" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="b2_box" value="B-2 🦴 Skeleton Loader 統一&#xa;&#xa;Spinner → Skeleton card 置換&#xa;packages/ui/src/primitives/Skeleton.tsx 新規&#xa;ScorePage / DecisionPage streaming / PersonaList / PreferencePage で利用&#xa;animate-pulse + motion-reduce:animate-none" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#FBC02D;fontColor=#F57F17;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=8;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="640" y="226" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b3_box" value="B-3 ⏩ Page Transitions&#xa;&#xa;View Transitions API (document.startViewTransition)&#xa;Chrome 111+ / Safari TP で動作、Firefox は instant fallback&#xa;依存ゼロ、~0 KB&#xa;route 切替時に自動 cross-fade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;fontColor=#4A148C;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=8;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="640" y="336" width="320" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="b4_box" value="B-4 📳 Haptic Feedback (Yes 採択時)&#xa;&#xa;navigator.vibrate?.(50)  // 50ms 短振動&#xa;Android Chrome: 動作 / iOS Safari: 無視&#xa;DecisionResult.tsx の Yes 採択 path に挿入&#xa;prefers-reduced-motion 尊重 (skip)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=8;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="640" y="442" width="320" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="risk_title" value="リスク / オープン論点" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#C62828;spacingLeft=12" parent="1" vertex="1">
                    <mxGeometry x="640" y="555" width="320" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="risk_box" value="O1 View Transitions API は Firefox 未対応 → fallback で即時遷移 (許容)&#xa;O2 iOS Safari の navigator.vibrate 無視 → Android 限定で振動&#xa;O3 sticky header + bottom nav で main 領域が縮む → 実機検証必要&#xa;O4 INCEPTION drawio (top nav icons) からの乖離 → Post-CONSTRUCTION v3 改修注記で明示&#xa;O5 bottom nav から persona/preference にアクセス不可 → Home Hub 経由維持" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#B71C1C;fontSize=9;align=left;verticalAlign=top;arcSize=8;spacingLeft=8;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="640" y="582" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="summary" value="🧩 サマリ: Sticky Header + Bottom Nav (4 tab) + Safe Area Insets (env(safe-area-inset-*)) でモバイル UX を「Web」→「App」に転換。Microinteractions (active/skeleton/transition/haptic) で触感を強化。新規依存ゼロ (canvas-confetti は Pack A の既存依存)、CSS / 標準 Web API のみで実現。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#E65100;fontSize=11;align=left;verticalAlign=middle;arcSize=8;spacingLeft=12;spacingRight=12;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="40" y="730" width="920" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
