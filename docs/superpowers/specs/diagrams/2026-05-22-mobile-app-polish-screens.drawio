                <mxCell id="iphone_safe_bottom_label" value="env(safe-area-inset-bottom) = ~34px" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=8;fontColor=#0288D1;fontStyle=2" parent="1" vertex="1">
