                <mxCell id="anno_top_arrow" value="↑ Notch 領域&#xa;safe-area-inset-top&#xa;で header padding 確保" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontColor=#01579B;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=8;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="380" y="146" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="anno_arrow1" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#0288D1;strokeWidth=2;endFill=1" parent="1" source="anno_top_arrow" target="iphone_safe_top_area" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="anno_sticky" value="🔒 Sticky Header (top:0)&#xa;scroll しても brand 常時表示&#xa;z-40 (Modal は z-50 で上書き)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontColor=#1B5E20;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=8;spacingTop=6" parent="1" vertex="1">
                    <mxGeometry x="380" y="220" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="anno_arrow2" style="endArrow=classic;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#43A047;strokeWidth=2;endFill=1" parent="1" source="anno_sticky" target="iphone_header" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="anno_main_pad" value="📐 main の pb (padding-bottom)&#xa;= 56px (BottomNav 高さ)&#xa;  + env(safe-area-inset-bottom)&#xa;  + 1rem (余裕)&#xa;で BottomNav に被らない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FB8C00;fontColor=#E65100;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=8;spacingTop=6" parent="1" vertex="1">
