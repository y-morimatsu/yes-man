                <mxCell id="p4_changes" value="新規  apps/web/src/features/auth/SplashPage.tsx&#xa;新規  apps/web/tests/features/auth/SplashPage.test.tsx&#xa;編集  apps/web/src/index.css                          @keyframes 追加&#xa;編集  apps/web/src/shell/routes.tsx                    /auth/splash route (lazy)&#xa;編集  apps/web/src/shell/RequireAuth.tsx               redirect 先を splash に&#xa;編集  apps/web/src/features/auth/SignInPage.tsx        visual polish (header/Card/list)&#xa;編集  apps/web/tests/shell/RequireAuth.test.tsx        新 redirect 先 test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#4A3D45;strokeWidth=1;fontColor=#262626;fontSize=11;align=left;verticalAlign=top;arcSize=8;spacingLeft=12;spacingTop=8;fontFamily=Courier New" parent="1" vertex="1">
