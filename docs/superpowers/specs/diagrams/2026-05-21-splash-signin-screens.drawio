                <mxCell id="p3_keyframe_box" value="@keyframes yesman-fade-in-up { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }&#xa;@keyframes yesman-fade-in-scale { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }&#xa;.splash-fade-in { opacity: 0; animation: yesman-fade-in-up 600ms ease-out forwards; }&#xa;.splash-fade-in-cta { opacity: 0; animation: yesman-fade-in-scale 500ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#4A3D45;strokeWidth=1;fontColor=#262626;fontSize=10;align=left;verticalAlign=top;arcSize=8;spacingLeft=12;spacingTop=8;fontFamily=Courier New" parent="1" vertex="1">
