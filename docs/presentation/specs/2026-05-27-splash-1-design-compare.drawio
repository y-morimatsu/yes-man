        </mxCell>

        <!-- M: 比率注釈 -->
        <mxCell id="M-annot" value="↑ blob size 44 (大きく、+ 縦横微小オフセット)&#10;↑ YesMan 46px italic Crimson (約 1.5 倍に拡大)&#10;↑ tagline 完全削除 (空気感を出す)&#10;↑ 「はじめる」 w-65% max-220px py-3 (絞って厚く)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="640" y="780" width="500" height="100" as="geometry" />
        </mxCell>

        <!-- =============== 右: 差分注釈 =============== -->
        <mxCell id="diff-header" value="主要差分 (5 項目)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#2E2418;" vertex="1" parent="1">
          <mxGeometry x="1220" y="80" width="540" height="30" as="geometry" />
        </mxCell>

        <mxCell id="diff-1" value="① 3 blob のサイズと配置&#10;現: 36px 整列 (横並び、揺らぎなし)&#10;#1: 44px + 縦横 ±1〜5px の微小オフセット&#10;  - orange: -y4 -x1 (上にずらす)&#10;  - green:  +y5 +x1 (下にずらす)&#10;  - blue:   -y3 -x1 (上にずらす)&#10;→ 機械的整列を緩めて「生きてる」 感を演出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D4A55D;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="120" width="540" height="130" as="geometry" />
        </mxCell>

        <mxCell id="diff-2" value="② blob と title の余白&#10;現: mb-4 (16px)&#10;#1: mb-7 (28px)&#10;→ blob 群と title 間に空気感、密集感を解消" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D4A55D;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="260" width="540" height="80" as="geometry" />
        </mxCell>

        <mxCell id="diff-3" value="③ YesMan title サイズ&#10;現: text-3xl (30px) italic Crimson Pro&#10;#1: fontSize 46px italic Crimson Pro + mb-4 (16px)&#10;→ 約 1.5 倍に拡大、splash の主役感を強化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D4A55D;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="350" width="540" height="90" as="geometry" />
        </mxCell>

        <mxCell id="diff-4" value="④ tagline 「人間最後の仕事は…」&#10;現: italic serif tagline 残存 (2 行)&#10;#1: 完全削除&#10;→ ミニマル化、3 blob + YesMan + button のみのシンプル splash&#10;  (tagline は宣言的すぎる、コンセプトは「はじめる」 行動で表現)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D4A55D;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="450" width="540" height="110" as="geometry" />
        </mxCell>

        <mxCell id="diff-5" value="⑤ 「はじめる」 button サイズ&#10;現: w-[78%] py-2.5 (画面の 78%、ほぼ全幅)&#10;#1: w-[65%] max-w-[220px] py-3 (65%、上限 220px、厚く)&#10;→ ボタンを画面幅から切り離して「タップしたい」要素として強調&#10;  iPhone SE / 12 Pro どちらも 220px cap で同じ視覚スケール" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D4A55D;strokeWidth=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="570" width="540" height="110" as="geometry" />
        </mxCell>

        <!-- 取込判断 -->
        <mxCell id="decision" value="📋 取込判断&#10;&#10;✅ ①③⑤ (blob 揺らぎ + title 拡大 + button 絞り) — splash の主役感 / 完成度向上&#10;⚠️ ④ tagline 削除 — 「YesMan の世界観を 1 行で伝える」 説明要素が消える&#10;   ハッカソンデモ的にはサブテキストあった方が分かりやすい可能性&#10;❌ ログイン link 関連 (mt-4 / text-11px) — #3 で link 既に削除済、適用先なし&#10;&#10;💡 推奨: blob 揺らぎ + title 46px + button 絞り (①②③⑤) のみ部分採用、&#10;   tagline (④) は残す方向 でいくか? user 判断待ち" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F0FF;strokeColor=#3A66B5;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1220" y="700" width="540" height="190" as="geometry" />
        </mxCell>

