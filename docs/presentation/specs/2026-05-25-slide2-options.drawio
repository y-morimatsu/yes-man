    <diagram id="page-a" name="A. 決断は毒">
        <mxGraphModel dx="1157" dy="783" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="bgA" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBFAF5;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry width="1920" height="1080" as="geometry"/>
                </mxCell>
                <mxCell id="progA" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B85C3D;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry width="320" height="6" as="geometry"/>
                </mxCell>
                <mxCell id="ebA" value="— 01 PROBLEM" style="text;html=1;align=left;verticalAlign=middle;fontColor=#B85C3D;fontSize=22;fontStyle=1;fontFamily=Helvetica;spacing=0;" parent="1" vertex="1">
                    <mxGeometry x="140" y="100" width="400" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="hdA" value="決断は、人類を最も効率的に&#xa;消耗させる毒である。" style="text;html=1;align=left;verticalAlign=top;fontColor=#1A1814;fontSize=68;fontFamily=serif;fontStyle=0;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="140" y="150" width="1640" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="statA1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AC91;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="140" y="430" width="540" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="statA1n" value="35,000" style="text;html=1;align=left;verticalAlign=top;fontColor=#B85C3D;fontSize=110;fontFamily=serif;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="170" y="450" width="500" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="statA1l" value="大人が 1 日に下す意思決定の数 (推定)。&#xa;小さな選択の累積が、夜には判断力を枯らす。" style="text;html=1;align=left;verticalAlign=top;fontColor=#3A362E;fontSize=22;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="170" y="600" width="500" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="statA2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AC91;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="690" y="430" width="540" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="statA2n" value="73%" style="text;html=1;align=left;verticalAlign=top;fontColor=#B85C3D;fontSize=110;fontFamily=serif;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="720" y="450" width="500" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="statA2l" value="「もうどうでもいい」で何もしなかった&#xa;経験のある社会人の割合 (自社調べ, N=120)。" style="text;html=1;align=left;verticalAlign=top;fontColor=#3A362E;fontSize=22;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="720" y="600" width="500" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="statA3" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8AC91;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="430" width="540" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="statA3n" value="意志力 = 有限" style="text;html=1;align=left;verticalAlign=top;fontColor=#B85C3D;fontSize=68;fontFamily=serif;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="1270" y="470" width="500" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="statA3l" value="決めるほど判断力は鈍り、&#xa;最後は他人の言いなりになる。" style="text;html=1;align=left;verticalAlign=top;fontColor=#3A362E;fontSize=22;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1270" y="600" width="500" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="qboxA" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAE5D9;strokeColor=#B85C3D;strokeWidth=0;" parent="1" vertex="1">
                    <mxGeometry x="140" y="760" width="1640" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="qboxAbar" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B85C3D;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="140" y="760" width="6" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="qboxAt" value="「決断疲労は意志力を侵食し、やがて人を意思のない生き物に変える。」" style="text;html=1;align=left;verticalAlign=top;fontColor=#1A1814;fontSize=32;fontFamily=serif;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="180" y="790" width="1560" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="qboxAa" value="— Roy F. Baumeister『Willpower』" style="text;html=1;align=left;verticalAlign=top;fontColor=#6B6557;fontSize=22;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="180" y="870" width="1560" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="conA" value="▶ だから、人類はずっと「決めない権利」を求めてきた。" style="text;html=1;align=left;verticalAlign=middle;fontColor=#B85C3D;fontSize=28;fontFamily=serif;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="140" y="970" width="1640" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
