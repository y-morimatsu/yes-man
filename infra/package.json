{
  "name": "@yesman/infra",
  "version": "0.1.0",
  "private": true,
  "description": "YesMan AWS CDK infrastructure (U1 / infra unit)",
  "scripts": {
    "build": "tsc --noEmit",
    "watch": "tsc -w --noEmit",
