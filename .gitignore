# ==============================================================
# YesMan / AI-DLC project .gitignore
# ==============================================================

# === OS / Editor ===
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# === IDE / Tools ===
.vscode/
.idea/
*.iml

# === AI-DLC framework (external dependency, not project source) ===
# 全体は ignore しつつ、YesMan 独自拡張 (Issue #6 で導入) のみ track する。
# git negation は親ディレクトリが ignore されていると効かないため、`/*` で
# 「中身を ignore」する形で記述し、その上で必要な subtree を `!` で復活。
.aidlc-rule-details/*
!.aidlc-rule-details/extensions/
.aidlc-rule-details/extensions/*
!.aidlc-rule-details/extensions/construction/
!.aidlc-rule-details/extensions/construction/**
!.aidlc-rule-details/extensions/frontend/
!.aidlc-rule-details/extensions/frontend/**

# === Claude Code session / settings ===
.claude/*
# 共有スキルは追跡対象 (settings*.json は引き続き無視)
!.claude/skills/

# === Python (CONSTRUCTION フェーズで apps/api 配下に登場予定) ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!infra/lib/
!infra/lib/**
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/

# === Node.js / pnpm (CONSTRUCTION フェーズで apps/web 配下に登場予定) ===
node_modules/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
.turbo/
.cache/
dist/
build/

# === Secrets / Local config ===
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# === Logs / Coverage ===
*.log
coverage/
.coverage
.pytest_cache/
htmlcov/

# === drawio backup files ===
*.drawio.bkp

# === Temp / scratch ===
*.tmp
*.bak
.tmp/

# === Playwright test artifacts (re-generated per run) ===
tests/e2e/test-results/
tests/e2e/playwright-report/data/
tests/e2e/playwright-report/trace/
